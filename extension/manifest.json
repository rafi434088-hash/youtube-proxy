{
  "manifest_version": 3,
  "name": "YouTube Proxy",
  "version": "1.0.0",
  "description": "מוריד סרטונים דרך GitHub Actions: התוסף שולח את הקישור והעוגיות לוורקפלואו, ומושך את התוצאה חזרה למחשב.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YouTube Proxy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "cookies",
    "downloads",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://api.github.com/*",
    "https://*.githubusercontent.com/*",
    "https://*.blob.core.windows.net/*"
  ]
}
