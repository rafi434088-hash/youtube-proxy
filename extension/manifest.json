{
  "manifest_version": 3,
  "name": "YouTube Proxy",
  "version": "1.1.0",
  "description": "מוריד סרטונים וערוצים שלמים דרך GitHub Actions: התוסף שולח את הקישור והעוגיות לוורקפלואו, ומושך את התוצאה חזרה למחשב.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YouTube Proxy — פתיחה בלשונית"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "cookies",
    "downloads",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://api.github.com/*",
    "https://*.githubusercontent.com/*",
    "https://*.blob.core.windows.net/*"
  ]
}
